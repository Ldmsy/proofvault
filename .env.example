# Copy to .env.local and fill in. Read only by the server, never sent to the browser.

# Option A — Anthropic API directly
ANTHROPIC_API_KEY=

# Option B — via OpenRouter (leave ANTHROPIC_API_KEY empty)
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=sk-or-...
# CLAUDE_MODEL=anthropic/claude-opus-5.5
